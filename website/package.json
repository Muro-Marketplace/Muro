{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm run test && npm run audit:allowlist",
    "audit:advisors": "tsx scripts/audit/snapshot-advisors.ts && tsx scripts/audit/check-regressions.ts",
    "audit:e2e-security": "playwright test tests/e2e/security-no-leaks.spec.ts",
    "depcheck": "depcruise src --config .dependency-cruiser.cjs",
    "audit:full": "npm run check && npm run audit:advisors && npm run audit:e2e-security",
    "audit:allowlist": "tsx scripts/audit/check-public-routes.ts"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@supabase/supabase-js": "^2.103.0",
    "@types/qrcode": "^1.5.6",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "date-fns": "^4.1.0",
    "konva": "^10.2.5",
    "next": "16.2.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-konva": "^19.2.3",
    "resend": "^6.10.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "stripe": "^22.0.1",
    "three": "^0.184.0",
    "use-image": "^1.1.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.0",
    "@vitest/ui": "^2.1.9",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
